<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Tüm modüllerin ortak derleme ayarları ve bağımlılık sürümleri tek yerde: servisler bağımsız
       deploy edilir, ama monorepo içinde sürümlerin dağılmasını (ör. farklı gRPC sürümleri) istemeyiz.
       Modüllerin pom.xml'lerinde yalnızca artifact adı var, sürüm yok. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.banking</groupId>
  <artifactId>banking-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>shared/banking-contracts</module>
    <module>services/account-service</module>
    <module>services/transfer-service</module>
    <module>services/notification-service</module>
    <module>api-gateway</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <spring-grpc.version>1.0.3</spring-grpc.version>
    <!-- protoc sürümü, spring-grpc-dependencies ${spring-grpc.version} ile gelen protobuf-java
         ile aynı olmalı. -->
    <protobuf-java.version>4.33.4</protobuf-java.version>
    <!-- gRPC kod üreticisi. Çalışma zamanındaki grpc-java 1.77.1'dir, ama üreticinin 1.77.1
         Windows binary'si çöküyor ("basic_string::_M_construct null not valid"); bu yüzden bir
         önceki seri kullanılır. Eski üreticinin kodu yeni çalışma zamanıyla uyumludur. -->
    <protoc-gen-grpc-java.version>1.76.3</protoc-gen-grpc-java.version>
    <protobuf-maven-plugin.version>4.0.3</protobuf-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.grpc</groupId>
        <artifactId>spring-grpc-dependencies</artifactId>
        <version>${spring-grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- İç modüller -->
      <dependency>
        <groupId>com.banking</groupId>
        <artifactId>banking-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- Dockerfile'lar jar'ı sürümden bağımsız bir adla kopyalayabilsin. -->
    <finalName>${project.artifactId}</finalName>
  </build>

</project>
