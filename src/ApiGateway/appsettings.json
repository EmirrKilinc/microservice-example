{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "accounts-route": {
        "ClusterId": "account-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      },
      "transfers-route": {
        "ClusterId": "transfer-cluster",
        "Match": {
          "Path": "/api/transfers/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "account-cluster": {
        "Destinations": {
          "account-service": {
            "Address": "http://account-service:8080/"
          }
        }
      },
      "transfer-cluster": {
        "Destinations": {
          "transfer-service": {
            "Address": "http://transfer-service:8080/"
          }
        }
      }
    }
  }
}
